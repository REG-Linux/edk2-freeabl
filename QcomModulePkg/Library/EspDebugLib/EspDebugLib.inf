## @file
#  DebugLib that records DEBUG()/ASSERT() into an in-RAM log (no screen output),
#  plus a console capture hook.  Read with `fastboot oem esp-log`.
#  Based on MdePkg UefiDebugLibConOut.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = EspDebugLib
  FILE_GUID                      = 6b8f2c1e-4a7d-4e3b-9c5f-1d2e3f4a5b6c
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DebugLib|DXE_CORE DXE_DRIVER DXE_RUNTIME_DRIVER UEFI_APPLICATION UEFI_DRIVER
  CONSTRUCTOR                    = DxeDebugLibConstructor
  DESTRUCTOR                     = EspDebugLibDestructor

[Sources]
  DebugLib.c
  DebugLibConstructor.c
  EspLog.c

[Packages]
  MdePkg/MdePkg.dec
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
  BaseMemoryLibOptDxe
  BaseLib
  PcdLib
  PrintLib
  DebugPrintErrorLevelLib

[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdDebugClearMemoryValue        ## SOMETIMES_CONSUMES
  gEfiMdePkgTokenSpaceGuid.PcdDebugPropertyMask            ## CONSUMES
  gEfiMdePkgTokenSpaceGuid.PcdFixedDebugPrintErrorLevel    ## CONSUMES
